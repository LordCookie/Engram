{
  "name": "engram-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Konsolen-Test-Engine (Dev-Werkzeug) zum groben Durchspielen von Decks/Synergien.",
  "scripts": {
    "test": "vite-node --script engine.test.ts && vite-node --script engine2.test.ts",
    "verify": "vite-node --script verify.ts",
    "build-decks": "vite-node --script build.ts",
    "pull-meta": "vite-node --script pull_meta.ts",
    "eval-meta": "vite-node --script eval_meta.ts",
    "import-decklists": "vite-node --script import_decklists.ts",
    "build-meta-decks": "vite-node --script build_meta_decks.ts",
    "decks": "vite-node --script run.ts decks",
    "battle": "vite-node --script run.ts battle",
    "game": "vite-node --script run.ts game",
    "agent-init": "vite-node --script run.ts agent-init",
    "agent-step": "vite-node --script run.ts agent-step"
  },
  "devDependencies": {
    "vite-node": "^2.1.9"
  }
}
