# Builds
dist/
app/dist/
app/dev-dist/

# Test / TS caches
coverage/
app/coverage/
**/.tmp/
*.tsbuildinfo

# Generierte Kartendaten NICHT verteilen (PLAN.md § 11 Leitplanken).
# Bei öffentlichem Repo zieht der Nutzer sie beim Build selbst (pipeline/fetch_cards.py).
app/src/data/cards.json
app/src/data/printings.json
# Synergie-Merkmale enthalten kurze Regeltext-Belege (CDPR-IP, § 8) → nicht verteilen.
app/src/data/features.json
# Kuratierte LLM-Lesefassung (Quelle für features.json) enthält Regeltext-Belege → nicht verteilen.
pipeline/features_curated.json
# Ingest: Deckdaten (eigene/fremde) + generiertes Co-Play-Korpus → nicht verteilen.
pipeline/decklists/*.json
app/src/data/coplay.json
# Keyword-Glossar-Transkription (CDPR-IP) → lokale Dev-Referenz, nicht verteilen.
pipeline/glossary.md

# sim (Konsolen-Test-Engine): Abhängigkeiten, Szenario-Decks (Deckdaten), Läufe.
sim/node_modules/
sim/decks/*.json
sim/.state.json
sim/out/

